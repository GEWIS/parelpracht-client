    "corepack": "^0.33.0",
    "file-saver": "^2.0.5",
    "history": "^5.3.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.1.0",
    "javascript-time-ago": "^2.5.11",
    "jose": "^6.0.13",
    "lodash": "^4.17.21",
    "marked": "^15.0.12",
    "query-string": "^9.2.2",
